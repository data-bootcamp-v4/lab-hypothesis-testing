# ===============================
# LAB | HYPOTHESIS TESTING
# Single-sheet solution
# ===============================

import pandas as pd
import numpy as np
import scipy.stats as st

alpha = 0.05

# ===============================
# CHALLENGE 1 — POKÉMON
# ===============================

df_pokemon = pd.read_csv(
    "https://raw.githubusercontent.com/data-bootcamp-v4/data/main/pokemon.csv"
)

print("\n=== Challenge 1 | Pokémon ===")

# ---- Hypothesis 1
# Dragon > Grass HP
dragon_hp = df_pokemon[df_pokemon["Type 1"] == "Dragon"]["HP"]
grass_hp = df_pokemon[df_pokemon["Type 1"] == "Grass"]["HP"]

t_stat, p_val = st.ttest_ind(
    dragon_hp, grass_hp,
    equal_var=False,
    alternative="greater"
)

print("\n[H1] Dragon vs Grass HP")
print(f"t-statistic = {t_stat:.3f}, p-value = {p_val:.4f}")

if p_val < alpha:
    print("Conclusion: Reject H0 → Dragon Pokémon have significantly higher HP.")
else:
    print("Conclusion: Fail to reject H0 → No significant difference in HP.")

# ---- Hypothesis 2
# Legendary vs Non-Legendary stats
stats = ["HP", "Attack", "Defense", "Sp. Atk", "Sp. Def", "Speed"]

legendary = df_pokemon[df_pokemon["Legendary"] == True]
non_legendary = df_pokemon[df_pokemon["Legendary"] == False]

print("\n[H2] Legendary vs Non-Legendary Stats")

for stat in stats:
    t_stat, p_val = st.ttest_ind(
        legendary[stat],
        non_legendary[stat],
        equal_var=False
    )
    
    decision = "Significant difference" if p_val < alpha else "No significant difference"
    print(f"{stat}: p-value = {p_val:.4f} → {decision}")

# ===============================
# CHALLENGE 2 — CALIFORNIA HOUSING
# ===============================

df_house = pd.read_csv(
    "https://raw.githubusercontent.com/data-bootcamp-v4/data/main/california_housing.csv"
)

print("\n=== Challenge 2 | California Housing ===")

# Distance function
def euclidean_distance(x1, y1, x2, y2):
    return np.sqrt((x1 - x2)**2 + (y1 - y2)**2)

# Coordinates
school = (-118, 34)
hospital = (-122, 37)

# Compute distances
df_house["dist_school"] = euclidean_distance(
    df_house["longitude"], df_house["latitude"],
    school[0], school[1]
)

df_house["dist_hospital"] = euclidean_distance(
    df_house["longitude"], df_house["latitude"],
    hospital[0], hospital[1]
)

# Close if within 0.5
df_house["close"] = (
    (df_house["dist_school"] < 0.5) |
    (df_house["dist_hospital"] < 0.5)
)

close_prices = df_house[df_house["close"]]["median_house_value"]
far_prices = df_house[~df_house["close"]]["median_house_value"]

# Hypothesis test (one-sided)
t_stat, p_val = st.ttest_ind(
    close_prices,
    far_prices,
    equal_var=False,
    alternative="greater"
)

print("\n[H3] Housing prices (Close vs Far)")
print(f"t-statistic = {t_stat:.3f}, p-value = {p_val:.4f}")

if p_val < alpha:
    print("Conclusion: Reject H0 → Houses close to a school or hospital are more expensive.")
else:
    print("Conclusion: Fail to reject H0 → No significant price difference found.")
