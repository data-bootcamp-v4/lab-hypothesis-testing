import numpy as np




df = pd.read_csv("https://raw.githubusercontent.com/data-bootcamp-v4/data/main/pokemon.csv")
df





import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import scipy.stats as st
df_dragon = df[(df["Type 1"] == "Dragon") | (df["Type 2"] == "Dragon")]["HP"]
df_grass  = df[(df["Type 1"] == "Grass")  | (df["Type 2"] == "Grass")]["HP"]



df_grass


#code 
# Ho: the mean of df_dragon ≤ mean of df_grass
# H1: the mean of df_dragon > mean of df_grass
#with alpha = 0.05
# I will use oneside t-test
st.ttest_ind(df_dragon, df_grass, equal_var=False, alternative="greater")
# the "p-value" is too small so we reject the null hypothesis.
# We accept the H1 which means that the average of HP of the pokemon dragon is higher than the average of HP of the grass.





df.info()


#code here
## H₀: Legendary and Non-Legendary Pokémon have the same average HP (μ₁ = μ₂)
## H₁: Legendary and Non-Legendary Pokémon have different average HP (μ₁ ≠ μ₂)
## Alph: 0.05
#st.ttest_ind(average_hp_legendary, average_hp_non_legendary, equal_var=False, alternative="two-sided")
import scipy.stats as st

# Calculate average HP (already correct)
average_hp_legendary = df[df["Legendary"] == True]["HP"].mean()
average_hp_non_legendary = df[df["Legendary"] == False]["HP"].mean()

# Get HP data, dropping NaNs just in case
legendary_hp = df[df["Legendary"] == True]["HP"].dropna()
non_legendary_hp = df[df["Legendary"] == False]["HP"].dropna()

# Perform two-sided Welch's t-test
t_stat, p_value = st.ttest_ind(
    legendary_hp,
    non_legendary_hp,
    equal_var=False,
    alternative="two-sided"
)

# Print results
print("Average HP - Legendary:", average_hp_legendary)
print("Average HP - Non-Legendary:", average_hp_non_legendary)
print("t-statistic:", t_stat)
print("p-value:", p_value)
## The p-value is very small the the H0 is rejected so the H1 is accepted which means that there is a differnce


