import pandas as pd
df = pd.read_csv("https://raw.githubusercontent.com/data-bootcamp-v4/data/main/california_housing.csv")
df.head()





# Coordinates
import numpy as np

school_coords = (-118, 34)
hospital_coords = (-122, 37)

# Function to calculate Euclidean distance
def euclidean_distance(lon1, lat1, lon2, lat2):
    return np.sqrt((lon1 - lon2)**2 + (lat1 - lat2)**2)

# Calculate distances
df['dist_to_school'] = df.apply(lambda row: euclidean_distance(row['longitude'], row['latitude'], *school_coords), axis=1)
df['dist_to_hospital'] = df.apply(lambda row: euclidean_distance(row['longitude'], row['latitude'], *hospital_coords), axis=1)

# Determine if a house is close to a school or hospital
df['is_close'] = (df['dist_to_school'] < 0.5) | (df['dist_to_hospital'] < 0.5)

# Optional: check correlation or price comparison
# print(df[df['is_close'] == True]['price'].mean())
# print(df[df['is_close'] == False]['price'].mean())



df.info()


df["is_close"].value_counts()


# check correlation or price comparison
print(df[df['is_close'] == True]['median_house_value'].mean())
print(df[df['is_close'] == False]['median_house_value'].mean())


# Group A: Houses close to school or hospital (is_close == True)
# Group B: Houses not close (is_close == False)

# Null Hypothesis (H₀): There is no difference in average house price between the two groups
# 𝜇 𝐴 = 𝜇 𝐵

# Alternative Hypothesis (H₁): Houses close to school or hospital have higher average prices
# 𝜇 𝐴 > 𝜇 𝐵
# Alpha =0.05, one tail test


from scipy.stats import ttest_ind

# Separate prices into two groups
close_prices = df[df['is_close'] == True]['median_house_value']
not_close_prices = df[df['is_close'] == False]['median_house_value']

# Perform one-tailed t-test
t_stat, p_value = ttest_ind(close_prices, not_close_prices, equal_var=False)

# Since it's a one-tailed test (greater), divide p-value by 2
p_value_one_tailed = p_value / 2

# Print results
print(f"T-statistic: {t_stat:.3f}")
print(f"One-tailed p-value: {p_value_one_tailed:.4f}")

# Check significance
alpha = 0.05
if p_value_one_tailed < alpha and t_stat > 0:
    print("✅ We reject the null hypothesis: Houses close to a school or hospital are significantly more expensive.")
else:
    print("❌ We fail to reject the null hypothesis: No significant evidence that close houses are more expensive.")







